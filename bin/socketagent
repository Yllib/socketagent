#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || echo "$SCRIPT_PATH")"
fi

REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
SERVER_DIR="$REPO_ROOT/server"
SERVICE_NAME="socketagent"

detect_service() {
  if systemctl --user list-unit-files "$SERVICE_NAME.service" >/dev/null 2>&1; then
    echo "$SERVICE_NAME"
    return
  fi
  if systemctl --user status socketclaude.service >/dev/null 2>&1; then
    echo "socketclaude"
    return
  fi
  echo "$SERVICE_NAME"
}

usage() {
  cat <<EOF
SocketAgent command line

Usage:
  socketagent pair [--raw]        Show pairing QR or raw pairing payload
  socketagent direct [--json]     Show direct/manual IP connection settings
  socketagent token               Show direct/manual auth token only
  socketagent install [args...]   Re-run server installer, e.g. --backends both
  socketagent status              Show server service status
  socketagent logs                Follow server logs
  socketagent restart             Restart server using the safe restart script
  socketagent adb-bridge [args...] Start ADB bridge sidecar
  socketagent phone-adb devices    Ask the connected phone app to run adb devices
  socketagent phone-adb pair <port> <code> Pair phone-local adb
  socketagent phone-adb connect <port> Connect phone-local adb
  socketagent phone-adb shell <cmd> Ask the connected phone app to run adb shell
  socketagent phone-adb adb <args> Ask the phone app to run arbitrary adb args
  socketagent phone-adb install <apk-path> [args] Install an APK through phone-local adb
  socketagent phone-adb open-apk <apk-path> Transfer an APK and open Android installer
  socketagent phone-adb logcat [args] Stream adb logcat through the phone app
  socketagent doctor              Print basic install diagnostics
  socketagent help                Show this help
EOF
}

cmd="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "$cmd" in
  pair|qr)
    exec node "$SERVER_DIR/scripts/show-pairing.js" "$@"
    ;;
  direct|manual)
    exec node "$SERVER_DIR/scripts/show-direct-auth.js" "$@"
    ;;
  token|auth-token|authtoken)
    exec node "$SERVER_DIR/scripts/show-direct-auth.js" --raw
    ;;
  install|setup)
    exec "$REPO_ROOT/install-server.sh" "$@"
    ;;
  status)
    exec systemctl --user status "$(detect_service)" "$@"
    ;;
  logs)
    exec journalctl --user -u "$(detect_service)" -f "$@"
    ;;
  restart)
    exec "$SERVER_DIR/scripts/restart-server.sh" "$@"
    ;;
  adb-bridge|adb)
    if [[ ! -f "$SERVER_DIR/dist/adb-bridge.js" ]]; then
      (cd "$SERVER_DIR" && npx tsc)
    fi
    exec node "$SERVER_DIR/dist/adb-bridge.js" "$@"
    ;;
  phone-adb)
    exec node "$SERVER_DIR/scripts/phone-adb.js" "$@"
    ;;
  doctor)
    echo "SocketAgent diagnostics"
    echo "Repo: $REPO_ROOT"
    echo "Server: $SERVER_DIR"
    echo "Node: $(command -v node || echo 'not found')"
    if command -v node >/dev/null 2>&1; then echo "Node version: $(node --version)"; fi
    echo "Claude CLI: $(command -v claude || echo 'not found')"
    echo "Codex CLI: $(command -v codex || echo 'not found')"
    active_service="$(detect_service)"
    echo "Service: $active_service"
    systemctl --user is-active "$active_service" >/dev/null 2>&1 \
      && echo "Service status: active" \
      || echo "Service status: not active"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "" >&2
    usage >&2
    exit 2
    ;;
esac
