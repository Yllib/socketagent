    "AgentSessionSettings": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "effort": {
          "$ref": "#/definitions/AgentEffort"
        },
        "thinking": {
          "$ref": "#/definitions/AgentThinkingSetting"
        },
        "codexFastMode": {
          "type": "boolean"
        },
        "codexCollaborationMode": {
          "type": "string"
