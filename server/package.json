{
  "name": "socketagent-server",
  "version": "1.1.35",
  "description": "WebSocket server bridging Flutter app to Claude Agent SDK",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run type-safety && node --test test/*.test.js test/*.test.mjs",
    "type-safety": "npm run protocol:check && npm run storage:check && node scripts/check-type-safety.mjs",
    "type-safety:report": "node scripts/check-type-safety.mjs --report",
    "codex:generate-contracts": "node scripts/generate-codex-contracts.mjs",
    "codex:check-contracts": "node scripts/generate-codex-contracts.mjs --check",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "release:patch": "npm version patch --no-git-tag-version",
    "protocol:generate": "node scripts/generate-client-protocol.mjs",
    "protocol:check": "node scripts/generate-client-protocol.mjs --check",
    "storage:generate": "node scripts/generate-stored-data.mjs",
    "storage:check": "node scripts/generate-stored-data.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@puppeteer/browsers": "3.2.1",
    "ajv": "8.20.0",
    "dotenv": "^16.4.7",
    "google-auth-library": "^10.9.0",
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "sherpa-onnx-node": "^1.13.3",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/qrcode-terminal": "0.12.2",
    "@types/ws": "^8.5.14",
    "eslint": "10.11.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.70.1"
  },
  "imports": {
    "#server/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  }
}
