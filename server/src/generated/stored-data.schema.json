        "supervisorSessionId": {
          "type": "string"
        },
        "childSessionId": {
          "type": "string"
        },
        "backend": {
          "$ref": "#/definitions/Backend"
        },
        "cwd": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/DelegatedAgentStatus"
